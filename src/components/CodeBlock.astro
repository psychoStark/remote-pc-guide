---
// CodeBlock.astro - Fluent & Liquid Glass Code Container with One-Click Copy
interface Props {
  code: string;
  language?: string;
  filename?: string;
}

const { code = '', language = 'bash', filename = '' } = Astro.props;
---

<div class="code-block-wrapper my-5 overflow-hidden rounded-2xl border border-[var(--border-strong)] bg-[#07090e] shadow-xl text-gray-200">
  <div class="flex items-center justify-between border-b border-white/10 bg-white/[0.03] px-4 py-2 text-xs">
    <div class="flex items-center gap-2">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
      </span>
      <span class="ml-2 font-mono text-[11px] font-medium text-gray-400">
        {filename || language}
      </span>
    </div>

    <button
      type="button"
      class="copy-btn inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1 text-[11px] font-medium text-white transition hover:bg-white/20 active:scale-95 focus-visible:outline-none"
      data-code={code}
      aria-label="Copy code to clipboard"
    >
      <svg class="copy-icon h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <span class="copy-label">Copy</span>
    </button>
  </div>

  <pre class="overflow-x-auto p-4 font-mono text-xs leading-relaxed text-emerald-300/90"><code>{code}</code></pre>
</div>

<script>
  import { triggerHaptic } from '../lib/haptics';

  function setupCodeCopy() {
    const buttons = document.querySelectorAll('.code-block-wrapper .copy-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-code');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          triggerHaptic('success');
          const label = btn.querySelector('.copy-label');
          if (label) label.textContent = 'Copied!';
          btn.classList.add('text-emerald-400');
          setTimeout(() => {
            if (label) label.textContent = 'Copy';
            btn.classList.remove('text-emerald-400');
          }, 2000);
        } catch {
          // Fallback
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupCodeCopy);
  document.addEventListener('astro:page-load', setupCodeCopy);
</script>
