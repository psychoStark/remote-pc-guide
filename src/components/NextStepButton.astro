---
interface Props {
  label?: string;
  href?: string;
  variant?: 'primary' | 'secondary';
}

const { label = 'Next step', href = '/', variant = 'primary' } = Astro.props;
const isSecondary = variant === 'secondary';
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-full px-6 py-3 text-sm font-semibold transition-all duration-300 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]',
    isSecondary
      ? 'border border-[var(--border)] bg-[var(--surface-container)] text-[var(--on-surface)] hover:bg-[var(--surface-container-high)] hover:border-[var(--border-strong)]'
      : 'bg-gradient-to-r from-[var(--primary)] to-violet-600 text-white shadow-lg shadow-[var(--primary)]/25 hover:shadow-[var(--primary)]/40 hover:-translate-y-0.5 specular-highlight',
  ]}
  data-next-step
>
  <span>{label}</span>
  <svg
    class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14"></path>
    <path d="m12 5 7 7-7 7"></path>
  </svg>
</a>

<script>
  import { triggerHaptic } from '../lib/haptics';

  function setupNextStepButtons() {
    const buttons = document.querySelectorAll('[data-next-step]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        triggerHaptic('navigation');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupNextStepButtons);
  document.addEventListener('astro:page-load', setupNextStepButtons);
</script>
