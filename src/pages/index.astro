---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const sectionLabels = {
	network: 'Network',
	routing: 'Routing',
	stream: 'Streaming',
	hardmod: 'Hardware fallback',
};
---

<BaseLayout title="Remote PC Guide">
	<main class="min-h-screen overflow-hidden">
		<section class="border-b border-black/10 bg-[#17232b] text-[#f6f1e8]">
			<div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-28">
				<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium tracking-[0.2em] text-[#f0a35b] uppercase">
					<span aria-hidden="true">⚡</span>
					Remote PC Guide
				</div>
				<div class="grid gap-12 md:grid-cols-[1.2fr_0.8fr]">
					<div>
						<h1 class="max-w-3xl text-5xl font-bold leading-[0.98] tracking-tight md:text-7xl">
							Your PC, wherever you are.
						</h1>
						<p class="mt-7 max-w-xl text-lg leading-8 text-[#c9d0d2]">
							A practical path from secure networking to low-latency streaming, wake-on-LAN, and a hardware backup when software gives up.
						</p>
						<div class="mt-9 flex flex-wrap items-center gap-3">
							<a
								href={`guides/${guides[0].id}/`}
								class="inline-flex items-center gap-3 rounded-full bg-[#f0a35b] px-5 py-3 font-semibold text-[#17232b] shadow-lg shadow-[#f0a35b]/20 transition hover:-translate-y-0.5 hover:bg-[#ffc27d]"
							>
								Start the guide <span aria-hidden="true">→</span>
							</a>
							<div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-[#dfe7ea]">
								<span>🛡️</span>
								Secure
							</div>
						</div>
					</div>
					<div class="flex items-end md:justify-end">
						<div class="w-full max-w-sm rounded-[32px] border border-white/10 bg-white/5 p-5 shadow-2xl shadow-[#0b1320]/25 backdrop-blur-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#f0a35b]">The reliable route</p>
							<div class="mt-4 space-y-3 text-sm leading-7 text-[#dfe7ea]">
								<div class="flex items-center justify-between rounded-2xl bg-white/5 px-3 py-2">
									<span>1. Secure access</span>
									<span>🛰️</span>
								</div>
								<div class="flex items-center justify-between rounded-2xl bg-white/5 px-3 py-2">
									<span>2. Wake the PC</span>
									<span>🔔</span>
								</div>
								<div class="flex items-center justify-between rounded-2xl bg-white/5 px-3 py-2">
									<span>3. Stream it</span>
									<span>🎮</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-20">
			<div class="mb-8 max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#b76532]">The path</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-[#17232b] md:text-4xl">Build the stack in four stages</h2>
			</div>

			<div class="grid gap-4 md:grid-cols-2">
				<a href="guides/01-tailscale-account/" class="group rounded-[var(--radius-lg)] border border-black/10 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
					<div class="flex items-center justify-between gap-4">
						<p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/45">01 — Network</p>
						<span class="rounded-full bg-[#f0a35b]/10 px-2 py-1 text-xs font-medium text-[#b76532]">🛰️</span>
					</div>
					<h3 class="mt-4 text-xl font-bold text-[#17232b] group-hover:text-[#b76532]">Secure access</h3>
					<p class="mt-3 text-sm leading-6 text-black/60">Create a Tailscale tailnet and install it on every device that needs to reach your home PC.</p>
				</a>
				<a href="guides/03-subnet-node/" class="group rounded-[var(--radius-lg)] border border-black/10 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
					<div class="flex items-center justify-between gap-4">
						<p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/45">02 — Routing</p>
						<span class="rounded-full bg-[#f0a35b]/10 px-2 py-1 text-xs font-medium text-[#b76532]">🔔</span>
					</div>
					<h3 class="mt-4 text-xl font-bold text-[#17232b] group-hover:text-[#b76532]">Wake and reach</h3>
					<p class="mt-3 text-sm leading-6 text-black/60">Add a subnet node and enable Wake-on-LAN so your PC can be reached or powered on from anywhere.</p>
				</a>
				<a href="guides/05-sunshine-setup/" class="group rounded-[var(--radius-lg)] border border-black/10 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
					<div class="flex items-center justify-between gap-4">
						<p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/45">03 — Streaming</p>
						<span class="rounded-full bg-[#f0a35b]/10 px-2 py-1 text-xs font-medium text-[#b76532]">🎮</span>
					</div>
					<h3 class="mt-4 text-xl font-bold text-[#17232b] group-hover:text-[#b76532]">Low-latency control</h3>
					<p class="mt-3 text-sm leading-6 text-black/60">Run Sunshine or Apollo on the host and Moonlight on the client for smooth remote gaming and desktop access.</p>
				</a>
				<a href="guides/07-esp32-switchbot/" class="group rounded-[var(--radius-lg)] border border-black/10 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
					<div class="flex items-center justify-between gap-4">
						<p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/45">04 — Backup</p>
						<span class="rounded-full bg-[#f0a35b]/10 px-2 py-1 text-xs font-medium text-[#b76532]">🛠️</span>
					</div>
					<h3 class="mt-4 text-xl font-bold text-[#17232b] group-hover:text-[#b76532]">Physical fallback</h3>
					<p class="mt-3 text-sm leading-6 text-black/60">If remote wake fails, use a simple ESP32 SwitchBot setup to press the power button without touching the machine.</p>
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
