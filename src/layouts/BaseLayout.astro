---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Remote PC Guide — Modern Low-Latency Streaming & Hardware Stack',
  description = 'A practical, step-by-step path to secure networking, ultra-low latency game streaming, remote Wake-on-LAN, and physical fail-safes.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" id="meta-theme-color" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />

    <!-- Google Fonts: Poppins & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-FOUC & View Transitions Persistent Theme Script -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'remote-pc-theme';

        function getPreferredTheme() {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved === 'dark' || saved === 'light') {
            return saved;
          }
          // Respect explicit system preference for light mode; otherwise default to AMOLED dark
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            return 'light';
          }
          return 'dark';
        }

        function applyTheme(theme) {
          const isDark = theme === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
          const meta = document.getElementById('meta-theme-color');
          if (meta) {
            meta.setAttribute('content', isDark ? '#000000' : '#f8f9fc');
          }
        }

        // Apply immediately before initial paint
        applyTheme(getPreferredTheme());

        // Re-apply immediately when Astro swaps the DOM during View Transitions
        document.addEventListener('astro:after-swap', function () {
          applyTheme(getPreferredTheme());
        });
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body class="relative min-h-screen bg-[var(--surface-base)] text-[var(--on-surface)] antialiased transition-colors duration-300">
    <!-- Ambient Liquid Glass Glow Layer -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
      <div class="ambient-glow-violet -top-32 -left-32 w-[520px] h-[520px] opacity-40 dark:opacity-30"></div>
      <div class="ambient-glow-green top-1/3 -right-32 w-[460px] h-[460px] opacity-25 dark:opacity-20"></div>
      <div class="ambient-glow-violet -bottom-40 left-1/4 w-[600px] h-[600px] opacity-30 dark:opacity-20"></div>
    </div>

    <!-- Theme Toggle Floating Action -->
    <ThemeToggle />

    <!-- Main Content Slot -->
    <slot />

    <!-- Global Haptic Feedback Engine -->
    <script>
      import { initGlobalHaptics } from '../lib/haptics';
      initGlobalHaptics();
      document.addEventListener('astro:page-load', initGlobalHaptics);
    </script>
  </body>
</html>
