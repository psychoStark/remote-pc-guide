---
import BaseLayout from './BaseLayout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { getGuideEntries, sectionLabels } from '../lib/guides';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const guides = await getGuideEntries();
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentStep = entry.data.order;
const totalSteps = guides.length;
const currentSection = sectionLabels[entry.data.section as keyof typeof sectionLabels] || 'Guide';
---

<BaseLayout title={`${entry.data.title} — Step ${currentStep} of ${totalSteps} | Remote PC Guide`}>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 pt-6 sm:pt-8">
    <!-- Top Breadcrumb Bar with Mobile Toggle Clearance -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs font-medium text-[var(--on-surface-muted)] pr-16 sm:pr-0">
      <a href={baseUrl} data-haptic="navigation" class="hover:text-[var(--primary)] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--primary)] font-semibold">{currentSection}</span>
      <span>/</span>
      <span class="text-[var(--on-surface)] truncate max-w-[200px] sm:max-w-none">{entry.data.title}</span>
    </nav>

    <div class="lg:grid lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-8 xl:gap-12">
      <!-- Sidebar Navigation (Windows Fluent / Mica Rounded-3xl Card) -->
      <aside class="mb-8 lg:mb-0">
        <div class="sticky top-6 rounded-3xl border border-[var(--border)] bg-[var(--surface-container)] p-5 shadow-xl backdrop-blur-xl transition-all duration-300">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-[var(--border)]">
            <a
              href={baseUrl}
              data-haptic="navigation"
              class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--primary)] hover:underline"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
              <span>Overview</span>
            </a>
            <span class="rounded-full bg-[var(--primary-soft)] px-2.5 py-0.5 text-[10px] font-bold text-[var(--primary)]">
              {currentStep}/{totalSteps}
            </span>
          </div>

          <h2 class="text-[11px] font-bold uppercase tracking-wider text-[var(--on-surface-variant)] mb-3 px-1">
            Guide Roadmap
          </h2>

          <nav aria-label="All steps" class="space-y-1.5">
            {guides.map((guide) => {
              const isActive = guide.id === entry.id;
              const isPast = guide.data.order < currentStep;
              return (
                <a
                  href={`${baseUrl}guides/${guide.id}/`}
                  data-haptic="navigation"
                  class:list={[
                    'group flex items-center gap-3 rounded-full px-3.5 py-2 text-xs font-medium transition-all duration-200 active:scale-98',
                    isActive
                      ? 'bg-gradient-to-r from-[var(--primary)] to-violet-600 text-white shadow-md shadow-[var(--primary)]/20 font-semibold'
                      : isPast
                        ? 'text-[var(--on-surface)] hover:bg-[var(--surface-container-high)]'
                        : 'text-[var(--on-surface-muted)] hover:bg-[var(--surface-container-high)] hover:text-[var(--on-surface)]',
                  ]}
                >
                  <span
                    class:list={[
                      'flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[10px] font-mono font-bold transition-colors',
                      isActive
                        ? 'bg-white/20 text-white'
                        : isPast
                          ? 'bg-[var(--secondary-soft)] text-[var(--secondary)]'
                          : 'bg-[var(--surface-container-high)] text-[var(--on-surface-muted)]',
                    ]}
                  >
                    {isPast ? '✓' : guide.data.order}
                  </span>
                  <span class="truncate">{guide.data.title}</span>
                </a>
              );
            })}
          </nav>
        </div>
      </aside>

      <!-- Main Content Area with Smooth Crossfade -->
      <main class="w-full max-w-3xl min-w-0">
        <!-- Progress Bar at top of guide -->
        <ProgressBar currentStep={currentStep} totalSteps={totalSteps} sectionName={currentSection} />

        <header class="mb-8">
          <div class="flex items-center gap-2 mb-2.5">
            <span class="rounded-full bg-[var(--primary-soft)] border border-[var(--primary)]/20 px-3 py-1 text-[11px] font-semibold text-[var(--primary)] tracking-wide uppercase">
              {currentSection}
            </span>
            <span class="text-xs text-[var(--on-surface-muted)]">Step {currentStep}</span>
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-[var(--on-surface)] leading-tight">
            {entry.data.title}
          </h1>

          {entry.data.description && (
            <p class="mt-3 text-base text-[var(--on-surface-muted)] leading-relaxed">
              {entry.data.description}
            </p>
          )}
        </header>

        <!-- Content and Widgets Slot -->
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
